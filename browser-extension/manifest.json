{
  "manifest_version": 3,
  "name": "JSON 拼接转换器 - ESJSON 助手",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "将本地 JSON 拼接转换器的结果自动发送到 ESJSON 可视化页面。",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["local-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://www.esjson.com/jsonviewer.html*",
        "https://www.esjson.com/jsonviewer.html*"
      ],
      "js": ["esjson-visualizer.js"],
      "run_at": "document_idle"
    }
  ]
}
